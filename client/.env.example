# Copy to .env.local and fill in. .env.local is gitignored.
#
# VITE_-prefixed values are inlined into the client bundle and are public.
# Everything else stays server-side (read by the /api routes only).

# OpenWeather — radar wind layer. https://openweathermap.org/api (free tier).
# Without it the Wind chip renders disabled and says why, rather than showing
# an empty overlay.
VITE_OWM_KEY=

# data.gov.in — CPCB real-time AQI, read by /api/aqi.
# https://data.gov.in/ -> register -> "My Account" -> API key.
# No IP whitelisting required, which is why this is the fast path to live data.
# SERVER ONLY: do not add a VITE_ prefix.
DATA_GOV_KEY=
